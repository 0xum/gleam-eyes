<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>../../build/bin/net8.0/plugins/gestures/</OutputPath>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Gleam.Engine\Gleam.Engine.csproj">
        <Private>false</Private>
      </ProjectReference>
    </ItemGroup>

    <Target Name="CleanGesturePluginOutput" BeforeTargets="Build">
      <ItemGroup>
        <GesturePluginLegacyDirs Include="$(OutputPath)Google.Protobuf" />
        <GesturePluginLegacyDirs Include="$(OutputPath)MediaPipe.Net.Protobuf" />
        <GesturePluginLegacyDirs Include="$(OutputPath)runtimes" />
      </ItemGroup>

      <RemoveDir Directories="@(GesturePluginLegacyDirs)" />

      <Delete Files="$(OutputPath)mediapipe_c.so" ContinueOnError="true" />
      <Delete Files="$(OutputPath)Mediapipe.Net.Framework.Protobuf.dll" ContinueOnError="true" />
      <Delete Files="$(OutputPath)Google.Protobuf.dll" ContinueOnError="true" />
    </Target>

    <Target Name="CopyPluginManagedDependencies" AfterTargets="Build">
      <PropertyGroup>
        <MediaPipeNetDll>$(NuGetPackageRoot)mediapipe.net/0.9.2/lib/net6.0/Mediapipe.Net.dll</MediaPipeNetDll>
        <GoogleProtobufDll>$(NuGetPackageRoot)google.protobuf/3.21.3/lib/netstandard2.0/Google.Protobuf.dll</GoogleProtobufDll>
        <MediaPipeProtobufDll>$(NuGetPackageRoot)mediapipe.net.framework.protobuf/0.9.1/lib/net6.0/Mediapipe.Net.Framework.Protobuf.dll</MediaPipeProtobufDll>
      </PropertyGroup>

      <Copy
        SourceFiles="$(MediaPipeNetDll)"
        DestinationFiles="$(OutputPath)Mediapipe.Net.dll"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeNetDll)')" />

      <Copy
        SourceFiles="$(GoogleProtobufDll)"
        DestinationFiles="$(OutputPath)Google.Protobuf.dll"
        SkipUnchangedFiles="true"
        Condition="Exists('$(GoogleProtobufDll)')" />

      <Copy
        SourceFiles="$(MediaPipeProtobufDll)"
        DestinationFiles="$(OutputPath)Mediapipe.Net.Framework.Protobuf.dll"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeProtobufDll)')" />
    </Target>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="11.3.11" />
      <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
      <PackageReference Include="Mediapipe.Net" Version="0.9.2" />
      <PackageReference Include="Mediapipe.Net.Runtime.CPU" Version="0.9.1" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Dependencies/mediapipe/**" />
      <None Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="obj\Gleam.Gestures.csproj.nuget.dgspec.json" />
      <Content Include="obj\Gleam.Gestures.csproj.nuget.g.props" />
      <Content Include="obj\Gleam.Gestures.csproj.nuget.g.targets" />
      <Content Include="obj\project.assets.json" />
      <Content Include="obj\project.nuget.cache" />
      <Content Include="obj\project.packagespec.json" />
      <Content Include="obj\rider.project.model.nuget.info" />
      <Content Include="obj\rider.project.restore.info" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaXaml Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Remove="obj\**" />
    </ItemGroup>

    <Target Name="CopyMediaPipeAssetsToRuntimeLayout" AfterTargets="Build">
      <ItemGroup>
        <MediaPipeAssetFiles Include="$(MSBuildProjectDirectory)/Dependencies/mediapipe/**/*" />
      </ItemGroup>

      <MakeDir Directories="$(OutputPath)mediapipe" />
      <Copy
        SourceFiles="@(MediaPipeAssetFiles)"
        DestinationFiles="@(MediaPipeAssetFiles->'$(OutputPath)mediapipe/%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyMediaPipeNativeRuntime" AfterTargets="Build">
      <PropertyGroup>
        <MediaPipeCpuRuntimeRoot>$(NuGetPackageRoot)mediapipe.net.runtime.cpu/0.9.1/runtimes</MediaPipeCpuRuntimeRoot>
        <AppBaseOutputPath>$(OutputPath)..\..\</AppBaseOutputPath>
        <AppRuntimeNativePath>$(AppBaseOutputPath)runtimes/linux-x64/native/</AppRuntimeNativePath>
        <AppRuntimeNativePathWin>$(AppBaseOutputPath)runtimes/win-x64/native/</AppRuntimeNativePathWin>
      </PropertyGroup>

      <MakeDir Directories="$(AppRuntimeNativePath)" />
      <MakeDir Directories="$(AppRuntimeNativePathWin)" />

      <Copy
        SourceFiles="$(MediaPipeCpuRuntimeRoot)/linux-x64/native/libmediapipe_c.so"
        DestinationFiles="$(OutputPath)libmediapipe_c.so"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeCpuRuntimeRoot)/linux-x64/native/libmediapipe_c.so')" />

      <Copy
        SourceFiles="$(MediaPipeCpuRuntimeRoot)/linux-x64/native/libmediapipe_c.so"
        DestinationFiles="$(AppBaseOutputPath)libmediapipe_c.so"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeCpuRuntimeRoot)/linux-x64/native/libmediapipe_c.so')" />

      <Copy
        SourceFiles="$(MediaPipeCpuRuntimeRoot)/linux-x64/native/libmediapipe_c.so"
        DestinationFiles="$(AppRuntimeNativePath)libmediapipe_c.so"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeCpuRuntimeRoot)/linux-x64/native/libmediapipe_c.so')" />

      <Copy
        SourceFiles="$(MediaPipeCpuRuntimeRoot)/win-x64/native/mediapipe_c.dll"
        DestinationFiles="$(OutputPath)mediapipe_c.dll"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeCpuRuntimeRoot)/win-x64/native/mediapipe_c.dll')" />

      <Copy
        SourceFiles="$(MediaPipeCpuRuntimeRoot)/win-x64/native/mediapipe_c.dll"
        DestinationFiles="$(AppBaseOutputPath)mediapipe_c.dll"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeCpuRuntimeRoot)/win-x64/native/mediapipe_c.dll')" />

      <Copy
        SourceFiles="$(MediaPipeCpuRuntimeRoot)/win-x64/native/mediapipe_c.dll"
        DestinationFiles="$(AppRuntimeNativePathWin)mediapipe_c.dll"
        SkipUnchangedFiles="true"
        Condition="Exists('$(MediaPipeCpuRuntimeRoot)/win-x64/native/mediapipe_c.dll')" />
    </Target>

</Project>
